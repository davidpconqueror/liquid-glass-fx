{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "liquid-glass-fx": ["./src/index.ts"],
      "liquid-glass-fx/react": ["./src/react/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*", "playground/**/*"],
  "exclude": ["node_modules", "dist"]
}

