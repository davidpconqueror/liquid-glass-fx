{
  "name": "liquid-glass-fx",
  "version": "0.1.2",
  "description": "High-performance liquid glass effect library with WebGL refraction, chromatic dispersion, and physical specular rim highlights.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"playground/src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"playground/src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"playground/**/*.{ts,tsx,html,css}\" \"*.{js,ts,json,md,yml}\" \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"playground/**/*.{ts,tsx,html,css}\" \"*.{js,ts,json,md,yml}\" \".github/**/*.{yml,yaml}\"",
    "audit": "yarn npm audit --all",
    "playground": "vite playground",
    "prepublishOnly": "yarn test && yarn typecheck && yarn lint && yarn build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidpconqueror/liquid-glass-fx.git"
  },
  "bugs": {
    "url": "https://github.com/davidpconqueror/liquid-glass-fx/issues"
  },
  "homepage": "https://github.com/davidpconqueror/liquid-glass-fx#readme",
  "keywords": [
    "liquid-glass",
    "glassmorphism",
    "webgl",
    "shader",
    "refraction",
    "chromatic-aberration",
    "fresnel",
    "react",
    "lens",
    "ui"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.14.0",
    "jsdom": "^26.0.0",
    "lucide-react": "^1.69.0",
    "prettier": "^3.9.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.11"
  }
}
